# SMTP untuk mengirim notifikasi form kontak. Email bhineka.global ada di Google Workspace.
# Isi di Vercel > Settings > Environment Variables. SMTP_PASS = App Password Google (16 karakter), bukan password login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Alamat tujuan notifikasi & alamat pengirim (default: SMTP_USER)
MAIL_TO=info@bhineka.global
MAIL_FROM=

# Cloudflare Turnstile (captcha). Isi di scope Production saja. Tanpa nilai ini, lokal & preview memakai test key
# Cloudflare (selalu lolos), sedangkan Production MENOLAK semua kiriman form sampai kunci asli diisi.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub OAuth App untuk login CMS (/admin)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
