# SMTP pengirim notifikasi form kontak: Resend (domain bhineka.global terverifikasi di resend.com).
# Isi di Vercel > Settings > Environment Variables (Production). SMTP_PASS = API key Resend (Sending access).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
# Tujuan notifikasi & alamat pengirim. MAIL_FROM WAJIB untuk Resend (SMTP_USER bukan alamat email).
MAIL_TO=info@bhineka.global
MAIL_FROM=website@bhineka.global

# Cloudflare Turnstile (captcha). Isi di scope Production saja. Tanpa nilai ini, lokal & preview memakai test key
# Cloudflare (selalu lolos), sedangkan Production MENOLAK semua kiriman form sampai kunci asli diisi.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub OAuth App untuk login CMS (/admin)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
