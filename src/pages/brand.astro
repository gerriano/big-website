---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Principals from '../components/home/Principals.astro';
import CtaBand from '../components/CtaBand.astro';
import { getBrands } from '../data/content';

const brands = await getBrands();
const categories = [...new Set(brands.map((b) => b.data.category))];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base title="Brand" description="Portofolio brand yang didistribusikan PT Bhineka Inovasi Global: Cheers, Calista, Let'z, Cocona, Lem Rajawali, New Bie, dan lainnya.">
  <PageHero
    eyebrow="Portofolio Brand"
    title="Brand yang kami gerakkan"
    lead="Dari air minum dalam kemasan hingga camilan dan kebutuhan rumah tangga — kami memastikan setiap brand hadir di rak yang tepat, di waktu yang tepat."
    image="/images/photos/rak-gudang.webp"
  />

  <section class="section brands" data-brands>
    <div class="container">
      <div class="brands-bar">
        <p class="brands-count"><strong>{brands.length}</strong> brand dalam portofolio</p>
        <div class="filters" role="group" aria-label="Filter kategori brand">
          <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">Semua</button>
          {
            categories.map((c) => (
              <button type="button" class="chip" data-filter={slug(c)} aria-pressed="false">
                {c}
              </button>
            ))
          }
        </div>
      </div>

      <ul class="brand-grid" data-brand-grid>
        {
          brands.map((b) => (
            <li class="bcard" id={b.id} data-cat={slug(b.data.category)}>
              <div data-reveal>
              <div class="bcard-media" data-gallery>
                <span class="bcard-slash" aria-hidden="true" />
                {b.data.images.map((src, i) => (
                  <img
                    src={src}
                    alt={`Produk ${b.data.name}${b.data.images.length > 1 ? ` (${i + 1})` : ''}`}
                    loading="lazy"
                    class:list={['bcard-img', { 'is-shown': i === 0 }]}
                  />
                ))}
                {b.data.images.length > 1 && (
                  <div class="bcard-dots" role="group" aria-label={`Foto ${b.data.name}`}>
                    {b.data.images.map((_, i) => (
                      <button
                        type="button"
                        class:list={['bcard-dot', { 'is-active': i === 0 }]}
                        data-show={i}
                        aria-label={`Tampilkan foto ${i + 1}`}
                      />
                    ))}
                  </div>
                )}
              </div>
              <div class="bcard-body">
                <p class="bcard-cat">{b.data.category}</p>
                <h2 class="bcard-name">{b.data.name}</h2>
                <p class="bcard-desc">{b.data.description}</p>
                {b.data.principal && (
                  <p class="bcard-principal">
                    Prinsipal: <strong>{b.data.principal}</strong>
                  </p>
                )}
              </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Principals />

  <CtaBand
    heading="Ingin brand Anda menjangkau lebih luas?"
    text="Kami membuka peluang kemitraan dengan prinsipal dan supplier yang ingin memperluas distribusi produknya di Indonesia."
    primary={{ label: 'Ajukan Kemitraan Prinsipal', href: '/kontak?kategori=Kemitraan%20Prinsipal' }}
    secondary={{ label: 'Tentang BIG', href: '/tentang-kami' }}
  />
</Base>

<style>
  .brands-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .brands-count {
    color: var(--muted);
  }

  .brands-count strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    color: var(--navy);
    margin-right: 4px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    font: inherit;
    font-weight: 500;
    font-size: 0.88rem;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .chip:hover {
    border-color: var(--navy);
  }

  .chip.is-active {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.4vw, 32px);
  }

  .bcard {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .bcard[hidden] {
    display: none;
  }

  .bcard:target .bcard-media {
    box-shadow: 0 0 0 3px var(--grad-start);
  }

  .bcard-media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    border-bottom-left-radius: 96px;
    background: var(--mist);
    overflow: hidden;
    isolation: isolate;
  }

  .bcard-slash {
    position: absolute;
    inset: -20% -40%;
    z-index: -1;
    background: var(--grad);
    clip-path: polygon(0 100%, 100% 30%, 100% 100%);
    transform: translateY(72%);
    transition: transform 0.7s var(--ease);
  }

  .bcard:hover .bcard-slash {
    transform: translateY(20%);
  }

  .bcard-img {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
    filter: drop-shadow(0 24px 24px rgba(0, 34, 63, 0.18));
    opacity: 0;
    transform: scale(0.92) rotate(-3deg);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease);
  }

  .bcard-img.is-shown {
    opacity: 1;
    transform: none;
  }

  .bcard:hover .bcard-img.is-shown {
    transform: scale(1.05) rotate(-2deg);
  }

  .bcard-dots {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: flex;
    gap: 6px;
  }

  .bcard-dot {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .bcard-dot::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background: var(--navy);
    opacity: 0.25;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .bcard-dot.is-active::before {
    opacity: 1;
    transform: scale(1.3);
  }

  .bcard-body {
    padding: 22px 6px 0;
  }

  .bcard-cat {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grad-start);
    margin-bottom: 6px;
  }

  .bcard-name {
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 10px;
  }

  .bcard-desc {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .bcard-principal {
    margin-top: 12px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .bcard-principal strong {
    color: var(--navy);
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    .brand-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .brand-grid {
      grid-template-columns: 1fr;
    }

    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .chip {
      flex: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  const root = document.querySelector<HTMLElement>('[data-brands]')!;
  const cards = Array.from(root.querySelectorAll<HTMLElement>('.bcard'));
  const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));

  // Category filter with a FLIP re-layout.
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter!;
      chips.forEach((c) => {
        c.classList.toggle('is-active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      const state = Flip.getState(cards);
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.cat !== filter;
      });
      if (reducedMotion) return;
      Flip.from(state, {
        duration: 0.7,
        ease: 'power3.inOut',
        absolute: true,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.6 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.9, duration: 0.4 }),
        onComplete: () => ScrollTrigger.refresh(),
      });
    }),
  );

  // Multi-photo brands: dots switch photos, and photos auto-cycle while hovered.
  root.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const imgs = Array.from(gallery.querySelectorAll<HTMLImageElement>('.bcard-img'));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.bcard-dot'));
    if (imgs.length < 2) return;
    let current = 0;
    let timer: number | undefined;
    const show = (i: number) => {
      current = (i + imgs.length) % imgs.length;
      imgs.forEach((img, j) => img.classList.toggle('is-shown', j === current));
      dots.forEach((d, j) => d.classList.toggle('is-active', j === current));
    };
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.show))));
    if (reducedMotion) return;
    gallery.addEventListener('pointerenter', () => {
      timer = window.setInterval(() => show(current + 1), 1400);
    });
    gallery.addEventListener('pointerleave', () => window.clearInterval(timer));
  });
</script>
