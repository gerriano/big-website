---
import { supergraphicViewBox, supergraphicRedSolid, supergraphicNavy, supergraphicWhite } from '../data/supergraphic';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: string;
}

const { eyebrow, title, lead, image = '/images/photos/gudang-luas.webp' } = Astro.props;
---

<section class="phero on-dark" data-phero>
  <div class="phero-visual" aria-hidden="true">
    <!-- Supergraphic from the Logo Playbook, same as the home hero: photo in the red block, navy block, white arrow. -->
    <svg viewBox={supergraphicViewBox} class="phero-svg">
      <defs>
        <clipPath id="phero-red-clip">
          <path d={supergraphicRedSolid}></path>
          <!-- Extends the red block upward past the artwork's top edge to the top of the section. -->
          <rect x="0" y="-4000" width="3508" height="4010"></rect>
        </clipPath>
        <linearGradient id="phero-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="3508" y2="0">
          <stop offset="0" stop-color="#e61e25"></stop>
          <stop offset="1" stop-color="#b50346"></stop>
        </linearGradient>
        <linearGradient id="phero-shade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#00223f" stop-opacity="0.85"></stop>
          <stop offset="0.45" stop-color="#00223f" stop-opacity="0.35"></stop>
          <stop offset="0.7" stop-color="#00223f" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="phero-navy" d={supergraphicNavy} fill="#002b52" fill-rule="evenodd"></path>
      <g clip-path="url(#phero-red-clip)">
        <g class="phero-panel">
          <rect y="-4000" width="3508" height="6480" fill="url(#phero-grad)"></rect>
          <image class="phero-photo" href={image} y="-1200" width="3508" height="3680" preserveAspectRatio="xMidYMid slice"></image>
          <rect y="-4000" width="3508" height="6480" fill="url(#phero-grad)" class="phero-tint"></rect>
        </g>
        <rect class="phero-shade" y="-4000" width="3508" height="6480" fill="url(#phero-shade)"></rect>
      </g>
      <path class="phero-arrow" d={supergraphicWhite} fill="#fff" fill-rule="evenodd"></path>
    </svg>
  </div>
  <div class="container phero-content">
    <p class="eyebrow phero-fade">{eyebrow}</p>
    <h1 class="display phero-title" data-split="load">{title}</h1>
    {lead && <p class="lead phero-fade">{lead}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: min(78svh, 720px);
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 64px) 0 clamp(56px, 7vw, 96px);
    background: radial-gradient(110% 100% at 0% 100%, var(--navy-700), var(--navy) 45%, var(--navy-900));
    color: #fff;
  }

  /* Anchored bottom-right so the navy block and the arrow's tail meet the section edge; sized by width so the
     arrowhead stays clear of the title, with the red block extending up to the top of the section. */
  .phero-visual {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(520px, 58vw, 1000px);
    aspect-ratio: 3508 / 2480;
    z-index: -1;
  }

  .phero-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .phero-tint {
    mix-blend-mode: multiply;
    opacity: 0.72;
  }

  .phero-content {
    position: relative;
  }

  .phero-title {
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    max-width: 10em;
    margin-bottom: 20px;
    text-shadow: 0 2px 40px rgba(0, 26, 51, 0.35);
  }

  .phero .lead {
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .phero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-top: 0;
    }

    .phero-visual {
      position: relative;
      bottom: auto;
      width: 128vw;
      margin: calc(var(--header-h) - 8px) -10vw 0 auto;
      -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
      mask-image: linear-gradient(to bottom, #000 78%, transparent);
    }

    .phero-shade {
      display: none;
    }

    .phero-content {
      margin-top: -3vw;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-phero]');
  if (hero && !reducedMotion) {
    gsap
      .timeline({ defaults: { ease: 'expo.out' } })
      .from(hero.querySelector('.phero-panel'), { x: -360, y: 200, opacity: 0, duration: 1.5 })
      .from(hero.querySelector('.phero-photo'), { scale: 1.25, transformOrigin: '70% 30%', duration: 2 }, 0)
      .from(hero.querySelector('.phero-navy'), { x: 260, y: 150, opacity: 0, duration: 1.4 }, 0.2)
      .from(hero.querySelector('.phero-arrow'), { x: -520, y: 300, opacity: 0, duration: 1.3 }, 0.45)
      .from(hero.querySelectorAll('.phero-fade'), { y: 24, opacity: 0, duration: 1, stagger: 0.1 }, 0.5);
  }
</script>
