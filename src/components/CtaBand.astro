---
import Arrow from './Arrow.astro';
import { home } from '../data/content';
import { supergraphicViewBox, supergraphicRed, supergraphicNavy } from '../data/supergraphic';

interface Props {
  heading?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { heading = home.cta.heading, text = home.cta.text, primary = home.cta.primaryCta, secondary = home.cta.secondaryCta } = Astro.props;
---

<section class="cta on-dark" data-cta>
  <svg class="cta-art" viewBox={supergraphicViewBox} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <linearGradient id="cta-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="3508" y2="0">
        <stop offset="0" stop-color="#e61e25"></stop>
        <stop offset="1" stop-color="#b50346"></stop>
      </linearGradient>
    </defs>
    <!-- The arrow is the white showing between the two blocks, so the artwork carries its own white ground. -->
    <rect class="cta-ground" width="3508" height="2480" fill="#fff"></rect>
    <path class="cta-red" d={supergraphicRed} fill="url(#cta-grad)" fill-rule="evenodd"></path>
    <path class="cta-navy" d={supergraphicNavy} fill="#003665" fill-rule="evenodd"></path>
  </svg>
  <div class="container cta-inner">
    <h2 class="h2 cta-title" data-split>{heading}</h2>
    <p class="lead" data-reveal>{text}</p>
    <div class="btn-row cta-actions" data-reveal>
      <a href={primary.href} class="btn btn--light">{primary.label} <Arrow /></a>
      {secondary && <a href={secondary.href} class="btn btn--ghost">{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  /* The playbook's closing composition: red block, navy block, and the white arrow formed by the gap between them. */
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: flex-start;
    /* Tall enough that the copy stays on the red block, above the arrow's barb. */
    min-height: clamp(600px, 62vw, 1000px);
    padding-block: clamp(64px, 7vw, 110px);
    background: #fff;
    color: #fff;
  }

  .cta-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .cta-inner {
    position: relative;
  }

  .cta-title {
    max-width: 9em;
    font-size: clamp(2.2rem, 4.2vw, 3.8rem);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  /* Stacked so the second button stays on the red block, clear of the arrow's barb. */
  .cta-actions {
    flex-direction: column;
    align-items: flex-start;
  }

  .cta .lead {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 34px;
  }

  /* Narrow screens: the copy sits on a red band whose gradient matches the artwork's, and the full composition follows. */
  @media (max-width: 900px) {
    .cta {
      flex-direction: column;
      min-height: 0;
      padding-block: 64px 0;
      background: linear-gradient(90deg, #e61e25, #b50346);
    }

    .cta-art {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 3508 / 2480;
      margin-top: -1px;
      order: 2;
    }

    .cta-inner {
      padding-bottom: 8px;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  // Red and navy blocks slide apart along the arrow's own angle, opening up the white arrow.
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((cta) => {
    if (reducedMotion) return;
    gsap
      .timeline({ scrollTrigger: { trigger: cta, start: 'top 75%' }, defaults: { duration: 1.4, ease: 'expo.out' } })
      .from(cta.querySelector('.cta-navy'), { x: 260, y: 150, opacity: 0 })
      .from(cta.querySelector('.cta-red'), { x: -200, y: -110, opacity: 0 }, 0.1);
  });
</script>
