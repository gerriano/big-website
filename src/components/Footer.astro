---
import Logo from './Logo.astro';
import { site } from '../data/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-slash" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="white" class="footer-logo" />
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-desc">{site.description}</p>
    </div>

    <nav class="footer-col" aria-label="Navigasi footer">
      <h2 class="footer-h">Jelajahi</h2>
      <ul>
        <li><a href="/">Beranda</a></li>
        <li><a href="/brand">Brand</a></li>
        <li><a href="/tentang-kami">Tentang Kami</a></li>
        <li><a href="/kontak">Kontak</a></li>
      </ul>
    </nav>

    {
      site.offices.map((office) => (
        <div class="footer-col">
          <h2 class="footer-h">
            {office.label} · {office.city}
          </h2>
          <p>{office.address}</p>
          <p>
            <a href={`tel:${office.phone.replace(/[^\d+]/g, '')}`}>{office.phone}</a>
          </p>
        </div>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p>
      © {year}
      {site.companyName} · Bagian dari {site.groupName}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--navy-950);
    color: rgba(255, 255, 255, 0.72);
    padding: clamp(64px, 8vw, 110px) 0 32px;
    font-size: 0.92rem;
  }

  .footer-slash {
    position: absolute;
    right: -10%;
    top: -40%;
    width: 60%;
    height: 180%;
    background: linear-gradient(120deg, rgba(230, 30, 37, 0.16), rgba(181, 3, 70, 0));
    transform: skewX(-32deg);
    pointer-events: none;
  }

  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr 1fr;
    gap: 40px;
  }

  .footer-logo {
    width: 150px;
    margin-bottom: 22px;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 10px;
  }

  .footer-desc {
    max-width: 36ch;
  }

  .footer-h {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 14px;
  }

  .footer-col p + p {
    margin-top: 8px;
  }

  .footer-col li + li {
    margin-top: 6px;
  }

  .site-footer a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: #fff;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-light);
    font-size: 0.82rem;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
